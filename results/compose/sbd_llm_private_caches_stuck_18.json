{
  "services": {
    "cache_a": {
      "image": "sbd-lab:latest",
      "command": [
        "python3",
        "/lab/cache_server.py"
      ],
      "user": "1000:1000",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "128m",
      "pids_limit": 64,
      "init": true,
      "networks": {
        "net_agent_a": {
          "aliases": [
            "cache"
          ]
        },
        "net_outside": {}
      },
      "environment": {
        "ALLOW_UPLOAD": "1",
        "ALLOW_MKCOL": "1",
        "ALLOW_PROPS": "1",
        "PULL_THROUGH": "1",
        "CACHE_MISSES": "1",
        "REMOTE_FETCH": "1",
        "RESOLVER_FORWARD": "0",
        "CREDENTIALS": "sbd-fake-shared-credential"
      }
    },
